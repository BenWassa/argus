# Argus content inbox — client configuration.
#
# Copy to `.env.local` and fill in from the Firebase console. Every value here
# is public web configuration that ships in the browser bundle: a Firebase web
# API key identifies a project, it does not authorize anything, and the
# authorized UID is an identity rather than a secret. Firestore Security Rules
# are the trust boundary.
#
# Never put a service-account key, a Firebase Admin credential or a GitHub
# token in a VITE_ variable. Vite inlines them into the bundle, and the build
# refuses to configure the inbox if it finds one.
#
# Leaving these unset is a supported configuration: the inbox reports itself
# unavailable and the rest of Argus is unaffected.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Optional, only if the project needs them.
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# The one Firebase UID allowed to read and write the inbox. Sign in to the
# deployed app once with the intended Google account and read the UID from
# Firebase console → Authentication → Users.
VITE_ARGUS_INBOX_UID=

# ---------------------------------------------------------------------------
# Maintainer ingestion only. These are NOT VITE_ variables and never reach the
# browser. Set them in the shell that runs `npm run inbox`.
#
# ARGUS_FIREBASE_PROJECT_ID=your-project
# ARGUS_INBOX_UID=                      # same UID as above
# GOOGLE_APPLICATION_CREDENTIALS=       # path to a service-account key file
#                                       # held outside this repository
