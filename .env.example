# Argus Firebase client configuration.
#
# Copy to `.env.local` and fill these values from the Firebase console. They are
# public web configuration that ships in the browser bundle. The API key
# identifies the Firebase project; Firebase Auth and Firestore Security Rules
# authorize access.
#
# These four values are required for the authenticated Argus application entry
# and per-account learner-library backup. Never put a service-account key,
# Firebase Admin credential, OAuth client secret or GitHub token in a VITE_
# variable. Vite inlines VITE_ values into the bundle.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Optional, only if the project needs them.
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional content-inbox restriction. Progress backup is available to every
# authenticated user, but the separate “Want to learn” inbox remains limited to
# this one configured Firebase UID. Leave this unset to disable only the inbox.
VITE_ARGUS_INBOX_UID=

# ---------------------------------------------------------------------------
# Maintainer/administrative tooling only. These are NOT VITE_ variables and
# never reach the browser.
#
# ARGUS_FIREBASE_PROJECT_ID=your-project
# ARGUS_INBOX_UID=                      # inbox owner UID above
# GOOGLE_APPLICATION_CREDENTIALS=       # service-account key held outside repo
