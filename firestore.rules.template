rules_version = '2';

// Generated using ARGUS_ALLOWED_IDENTITIES: exact UID/email pairs.
service cloud.firestore {
  match /databases/{database}/documents {

    // Both claims must match the same configured identity. No email aliases.
    function owner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (__ARGUS_ALLOWED_IDENTITIES__);
    }

    function soleUser(userId) {
      return owner() && userId == request.auth.uid;
    }

    // ---------------------------------------------------------------- inbox

    function validTrackHint(data) {
      return !('trackHint' in data.keys())
        || data.trackHint == null
        || data.trackHint in ['learning', 'survival', 'tradecraft'];
    }

    function validText(data) {
      return data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.text.trim() == data.text;
    }

    // A pending request is intent and nothing else: one piece of text, an
    // optional track hint, and a creation time the client cannot choose. No
    // scope, no items, no status ladder, no progress, no evidence.
    function validPending(data) {
      return data.keys().hasOnly(['text', 'status', 'trackHint', 'createdAt'])
        && data.keys().hasAll(['text', 'status', 'createdAt'])
        && data.status == 'pending'
        && validText(data)
        && validTrackHint(data)
        && data.createdAt == request.time;
    }

    // The only legitimate transition: pending becomes added, once, carrying the
    // shipped topic ids it produced and a server-set time. The captured text,
    // its track hint and its creation time are immutable, so a request's
    // provenance cannot be rewritten after the fact. Rules cannot know whether
    // a topic id is real; ingestion checks that against the shipped catalog.
    function validAddition(before, after) {
      return after.keys().hasOnly(['text', 'status', 'trackHint', 'createdAt', 'topicIds', 'addedAt'])
        && after.keys().hasAll(['text', 'status', 'createdAt', 'topicIds', 'addedAt'])
        && before.status == 'pending'
        && after.status == 'added'
        && after.text == before.text
        && after.createdAt == before.createdAt
        && after.get('trackHint', null) == before.get('trackHint', null)
        && after.topicIds is list
        && after.topicIds.size() > 0
        && after.topicIds.size() <= 20
        && after.addedAt == request.time;
    }

    match /users/{userId}/inbox/{requestId} {
      allow read: if soleUser(userId);
      allow create: if soleUser(userId) && validPending(request.resource.data);
      allow update: if soleUser(userId) && validAddition(resource.data, request.resource.data);
      // A request can be dropped while it is still only intent. Once it has
      // shipped topics attached, the record is ingestion provenance and stays.
      allow delete: if soleUser(userId) && resource.data.status == 'pending';
    }

    // -------------------------------------------------------------- library

    // A synced record is carried as the exact JSON the v5 boundary already
    // validates, not as a second Firestore-shaped schema. Rules cannot check a
    // learning record's meaning — whether a gap is satisfied, whether evidence
    // counts — and pretending otherwise would put a second, weaker definition
    // of the contract somewhere it can drift from the first. So these rules
    // guard exactly what rules can guard: who is writing, that the payload is
    // bounded text, and that the device did not choose its own clock.
    function validSynced(data, keys) {
      return data.keys().hasOnly(keys)
        && data.keys().hasAll(keys)
        && data.json is string
        && data.json.size() > 0
        && data.json.size() <= 900000
        && data.revision is int
        && data.revision >= 0
        && data.updatedAt == request.time;
    }

    // One document per topic, so two of the owner's devices editing different
    // topics do not overwrite each other — the whole reason this is not a
    // single blob.
    match /users/{userId}/library/{topicId} {
      allow read: if soleUser(userId);
      allow create, update: if soleUser(userId)
        && validSynced(request.resource.data, ['json', 'revision', 'updatedAt', 'topicId'])
        && request.resource.data.topicId == topicId;
      // A topic deleted on one device is deleted on the others.
      allow delete: if soleUser(userId);
    }

    // Library-level state that is not any one topic: the record version and
    // which catalog topics have been delivered.
    match /users/{userId}/libraryMeta/{docId} {
      allow read: if soleUser(userId);
      allow create, update: if soleUser(userId)
        && validSynced(request.resource.data, ['json', 'revision', 'updatedAt']);
      allow delete: if soleUser(userId);
    }

    // Nothing else in this project belongs to Argus.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
