rules_version = '2';

// Argus — Firestore Security Rules.
//
// Argus keeps two things in the cloud, both belonging to one owner:
//
//   users/{uid}/inbox       — captured content requests (intent, not progress)
//   users/{uid}/library     — one exact v5 JSON topic document per topic
//   users/{uid}/libraryMeta — library-level catalog-delivery state
//
// The v5 parse boundary in `src/lib/storage.ts` remains the arbiter of learner
// record meaning. Rules enforce identity, bounded payloads, server timestamps
// and monotonic revisions; the client performs conservative semantic conflict
// detection and Firestore transactions provide compare-and-set writes.

service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmails() {
      return [__ARGUS_OWNER_EMAILS__];
    }

    function owner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ownerEmails();
    }

    function soleUser(userId) {
      return owner() && userId == request.auth.uid;
    }

    // ---------------------------------------------------------------- inbox

    function validTrackHint(data) {
      return !('trackHint' in data.keys())
        || data.trackHint == null
        || data.trackHint in ['learning', 'survival', 'tradecraft'];
    }

    function validText(data) {
      return data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.text.trim() == data.text;
    }

    function validPending(data) {
      return data.keys().hasOnly(['text', 'status', 'trackHint', 'createdAt'])
        && data.keys().hasAll(['text', 'status', 'createdAt'])
        && data.status == 'pending'
        && validText(data)
        && validTrackHint(data)
        && data.createdAt == request.time;
    }

    function validAddition(before, after) {
      return after.keys().hasOnly(['text', 'status', 'trackHint', 'createdAt', 'topicIds', 'addedAt'])
        && after.keys().hasAll(['text', 'status', 'createdAt', 'topicIds', 'addedAt'])
        && before.status == 'pending'
        && after.status == 'added'
        && after.text == before.text
        && after.createdAt == before.createdAt
        && after.get('trackHint', null) == before.get('trackHint', null)
        && after.topicIds is list
        && after.topicIds.size() > 0
        && after.topicIds.size() <= 20
        && after.addedAt == request.time;
    }

    match /users/{userId}/inbox/{requestId} {
      allow read: if soleUser(userId);
      allow create: if soleUser(userId) && validPending(request.resource.data);
      allow update: if soleUser(userId) && validAddition(resource.data, request.resource.data);
      allow delete: if soleUser(userId) && resource.data.status == 'pending';
    }

    // -------------------------------------------------------------- library

    function validSynced(data, keys) {
      return data.keys().hasOnly(keys)
        && data.keys().hasAll(keys)
        && data.json is string
        && data.json.size() > 0
        && data.json.size() <= 900000
        && data.revision is int
        && data.revision >= 1
        && data.updatedAt == request.time;
    }

    function validTopicIdentity(data, topicId) {
      return data.topicId is string && data.topicId == topicId;
    }

    match /users/{userId}/library/{topicId} {
      allow read: if soleUser(userId);
      allow create: if soleUser(userId)
        && validSynced(request.resource.data, ['json', 'revision', 'updatedAt', 'topicId'])
        && validTopicIdentity(request.resource.data, topicId)
        && request.resource.data.revision == 1;
      allow update: if soleUser(userId)
        && validSynced(request.resource.data, ['json', 'revision', 'updatedAt', 'topicId'])
        && validTopicIdentity(request.resource.data, topicId)
        && request.resource.data.revision == resource.data.revision + 1;
      // Deletion is allowed only to the owner. The client performs it inside a
      // transaction after reading the exact expected revision, so a concurrent
      // edit makes the transaction retry/fail rather than being erased.
      allow delete: if soleUser(userId);
    }

    // Catalog-delivery metadata is a small monotonic set-union record. Its
    // current client writes revision 1 as a format marker; unlike topic records,
    // no learner evidence/history lives here and no conflict winner is inferred
    // from this number.
    match /users/{userId}/libraryMeta/{docId} {
      allow read: if soleUser(userId);
      allow create, update: if soleUser(userId)
        && validSynced(request.resource.data, ['json', 'revision', 'updatedAt']);
      allow delete: if soleUser(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
