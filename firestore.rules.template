rules_version = '2';

// Argus Firebase storage.
//
// Learner progress is one canonical v5 library document per authenticated UID.
// Firestore adds only synchronization metadata; the browser parser remains the
// learner-schema trust boundary. The content inbox stays a separate, narrower
// beta feature restricted to the configured owner UID.

service cloud.firestore {
  match /databases/{database}/documents {

    function authorizedInboxUid() {
      return '__ARGUS_AUTHORIZED_UID__';
    }

    function ownsUserPath(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function soleInboxUser(userId) {
      return ownsUserPath(userId)
        && request.auth.uid == authorizedInboxUid()
        && userId == authorizedInboxUid();
    }

    function validLibraryEnvelope(data) {
      return data.keys().hasOnly(['format', 'revision', 'library', 'lastMutationId', 'updatedAt'])
        && data.keys().hasAll(['format', 'revision', 'library', 'lastMutationId', 'updatedAt'])
        && data.format == 1
        && data.revision is int
        && data.revision >= 1
        && data.library is map
        && data.library.version == 5
        && data.lastMutationId is string
        && data.lastMutationId.size() > 0
        && data.lastMutationId.size() <= 200
        && data.updatedAt == request.time;
    }

    function validLibraryCreate(data) {
      return validLibraryEnvelope(data) && data.revision == 1;
    }

    function validLibraryUpdate(before, after) {
      return validLibraryEnvelope(after)
        && before.format == 1
        && before.revision is int
        && after.revision == before.revision + 1;
    }

    // Exactly one learner-library document belongs to a UID. Account A cannot
    // read, create or mutate account B's copy, even if both are valid Google
    // users. Deletes are intentionally disallowed; reset is a normal revision
    // containing the explicit reset library so it remains conflict-detectable.
    match /users/{userId}/library/{documentId} {
      allow read: if documentId == 'current' && ownsUserPath(userId);
      allow create: if documentId == 'current'
        && ownsUserPath(userId)
        && validLibraryCreate(request.resource.data);
      allow update: if documentId == 'current'
        && ownsUserPath(userId)
        && validLibraryUpdate(resource.data, request.resource.data);
      allow delete: if false;
    }

    function validTrackHint(data) {
      return !('trackHint' in data.keys())
        || data.trackHint == null
        || data.trackHint in ['learning', 'survival', 'tradecraft'];
    }

    function validText(data) {
      return data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.text.trim() == data.text;
    }

    function validPending(data) {
      return data.keys().hasOnly(['text', 'status', 'trackHint', 'createdAt'])
        && data.keys().hasAll(['text', 'status', 'createdAt'])
        && data.status == 'pending'
        && validText(data)
        && validTrackHint(data)
        && data.createdAt == request.time;
    }

    function validAddition(before, after) {
      return after.keys().hasOnly(['text', 'status', 'trackHint', 'createdAt', 'topicIds', 'addedAt'])
        && after.keys().hasAll(['text', 'status', 'createdAt', 'topicIds', 'addedAt'])
        && before.status == 'pending'
        && after.status == 'added'
        && after.text == before.text
        && after.createdAt == before.createdAt
        && after.get('trackHint', null) == before.get('trackHint', null)
        && after.topicIds is list
        && after.topicIds.size() > 0
        && after.topicIds.size() <= 20
        && after.addedAt == request.time;
    }

    match /users/{userId}/inbox/{requestId} {
      allow read: if soleInboxUser(userId);
      allow create: if soleInboxUser(userId) && validPending(request.resource.data);
      allow update: if soleInboxUser(userId) && validAddition(resource.data, request.resource.data);
      allow delete: if soleInboxUser(userId) && resource.data.status == 'pending';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
