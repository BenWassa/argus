# Argus — the embeddable demo build (`npm run build:demo`, i.e. `vite build --mode demo`).
#
# Committed on purpose: it holds no secret and exists so the demo needs none.
# A demo is entirely local (no sign-in, no sync, no inbox, no service worker,
# nothing persisted), so every Firebase variable is blank here. That also masks
# any value a developer keeps in `.env.local`, which Vite would otherwise load.
# The demo flag below makes the app ignore Firebase configuration regardless.

VITE_ARGUS_DEMO=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_ARGUS_INBOX_UID=
