{
  "name": "argus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check": "npm run test && npm run build && npm run test:browser",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "inbox:rules": "node scripts/renderRules.mjs",
    "inbox": "node scripts/inbox/cli.mjs",
    "test:rules": "node scripts/renderRules.mjs --emulator && npx --yes firebase-tools@14 emulators:exec --only firestore --project argus-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "motion": "^13.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
